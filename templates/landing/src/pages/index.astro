---
import DebugPanel from '../components/DebugPanel.astro';
import DoneScreen from '../components/DoneScreen.astro';
import EmailScreen from '../components/EmailScreen.astro';
import QuestionsScreen from '../components/QuestionsScreen.astro';
import Base from '../layouts/Base.astro';

const promiseScreens = import.meta.glob<typeof DoneScreen>('../promise/Promise.astro', { eager: true, import: 'default' });
const [PromiseScreen] = Object.values(promiseScreens);

if (!PromiseScreen) {
  throw new Error('Missing src/promise/Promise.astro: the free screen programmed from the approved boards goes there.');
}
---

<Base>
  <main class="grow">
    <PromiseScreen />
    <EmailScreen />
    <QuestionsScreen />
    <DoneScreen />
  </main>
  <DebugPanel />
  <script src="../scripts/flow.ts"></script>
</Base>
