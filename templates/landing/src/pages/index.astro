---
import CenteredPromise from '../components/CenteredPromise.astro';
import DebugPanel from '../components/DebugPanel.astro';
import DoneScreen from '../components/DoneScreen.astro';
import EmailScreen from '../components/EmailScreen.astro';
import EditorialPromise from '../components/EditorialPromise.astro';
import QuestionsScreen from '../components/QuestionsScreen.astro';
import SplitPromise from '../components/SplitPromise.astro';
import Base from '../layouts/Base.astro';
import { tokens } from '../lib/tokens';

const PromiseLayout = { centered: CenteredPromise, split: SplitPromise, editorial: EditorialPromise }[tokens.composition];
---

<Base>
  <main class="grow">
    <PromiseLayout />
    <EmailScreen />
    <QuestionsScreen />
    <DoneScreen />
  </main>
  <DebugPanel />
  <script src="../scripts/flow.ts"></script>
</Base>
