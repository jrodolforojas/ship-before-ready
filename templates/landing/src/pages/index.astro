---
import Brand from '../components/Brand.astro';
import Closing from '../components/Closing.astro';
import DebugPanel from '../components/DebugPanel.astro';
import DoneScreen from '../components/DoneScreen.astro';
import EmailScreen from '../components/EmailScreen.astro';
import Figure from '../components/Figure.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Pains from '../components/Pains.astro';
import QuestionsScreen from '../components/QuestionsScreen.astro';
import Steps from '../components/Steps.astro';
import Base from '../layouts/Base.astro';
---

<Base>
  <main class="grow">
    <section data-sbr="screen-promise" aria-labelledby="title" class="mx-auto flex w-full max-w-page flex-col gap-block px-group md:gap-section">
      <header class="flex justify-center pt-group">
        <Brand />
      </header>
      <Hero />
      <Figure />
      <Pains />
      <Steps />
      <Closing />
      <Footer />
    </section>
    <EmailScreen />
    <QuestionsScreen />
    <DoneScreen />
  </main>
  <DebugPanel />
  <script src="../scripts/flow.ts"></script>
</Base>
