---
interface Props {
  hook: string;
  label: string;
  type?: 'button' | 'submit';
  sendingLabel?: string;
  class?: string;
}

const { hook, label, type = 'button', sendingLabel, class: widthClasses = 'w-full' } = Astro.props;
---

<button
  data-sbr={hook}
  type={type}
  data-sending-label={sendingLabel}
  class:list={[
    'inline-flex touch-target items-center justify-center rounded-control bg-accent px-group py-item text-center font-body text-button text-on-accent transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus active:opacity-80 disabled:opacity-60',
    widthClasses,
  ]}
>{label}</button>
