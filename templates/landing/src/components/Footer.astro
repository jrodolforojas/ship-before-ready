---
import { copy } from '../lib/copy';
import { tokens } from '../lib/tokens';

const layout = {
  centered: 'flex flex-col gap-item text-center',
  split: 'flex flex-col gap-item lg:grid lg:grid-cols-split lg:items-start lg:gap-block',
  editorial: 'flex max-w-prose flex-col gap-item text-body',
}[tokens.composition];
---

<footer data-sbr="footer" class="border-t border-line pt-group pb-block">
  <div class:list={['font-body text-ink-muted', layout]}>
    <p class="font-body text-small text-ink-muted">{copy.footer.author}</p>
    <p class="font-body text-small text-ink-muted">{copy.footer.privacy}</p>
  </div>
</footer>
