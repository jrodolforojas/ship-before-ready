---
import { copy } from '../lib/copy';
import { tokens } from '../lib/tokens';
import FilledButton from './FilledButton.astro';

const layout = {
  centered: {
    closing: 'flex flex-col items-center gap-group rounded-card border border-line bg-surface px-group py-block text-center shadow-card md:p-section',
    button: 'w-full md:w-auto',
  },
  split: {
    closing: 'flex flex-col gap-group md:items-start lg:grid lg:grid-cols-split lg:items-center lg:gap-block',
    button: 'w-full md:w-auto lg:justify-self-start',
  },
  editorial: {
    closing: 'flex max-w-prose flex-col items-start gap-group text-body',
    button: 'w-auto',
  },
}[tokens.composition];
---

<div class={layout.closing}>
  <h2 data-sbr="closing" tabindex="-1" class="font-display text-heading text-balance text-ink">{copy.closing}</h2>
  <FilledButton hook="cta-closing" label={copy.cta} class={layout.button} />
</div>
