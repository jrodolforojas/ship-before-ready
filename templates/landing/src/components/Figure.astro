---
import { tokens } from '../lib/tokens';

interface Props {
  class?: string;
}

const { class: placement } = Astro.props;

const GRID_COLUMNS = 32;
const GRID_ROWS = 18;
const columns = Array.from({ length: GRID_COLUMNS });
const rows = Array.from({ length: GRID_ROWS });
---

{
  tokens.decor === 'shapes' && (
    <div data-sbr="figure" aria-hidden="true" class:list={['grid aspect-16/9 grid-cols-1 grid-rows-1', placement]}>
      <div data-sbr="decor-1" class="z-1 col-start-1 row-start-1 h-2/3 aspect-square self-center justify-self-start circle bg-accent opacity-20" />
      <div data-sbr="decor-2" class="col-start-1 row-start-1 h-full w-3/4 justify-self-end rounded-card border border-line" />
    </div>
  )
}
{
  tokens.decor === 'grid' && (
    <div data-sbr="figure" aria-hidden="true" class:list={['grid aspect-16/9 grid-cols-1 grid-rows-1 overflow-hidden', placement]}>
      <div data-sbr="decor-1" class="col-start-1 row-start-1 grid size-full grid-cols-1 grid-rows-1 overflow-hidden border-r border-b border-line">
        <div class="col-start-1 row-start-1 flex">
          {columns.map(() => <span class="h-full w-block shrink-0 border-l border-line" />)}
        </div>
        <div class="col-start-1 row-start-1 flex flex-col">
          {rows.map(() => <span class="h-block w-full shrink-0 border-t border-line" />)}
        </div>
      </div>
      <div data-sbr="decor-2" class="col-start-1 row-start-1 mt-block ml-block size-block translate-x-full self-start justify-self-start bg-accent" />
    </div>
  )
}
