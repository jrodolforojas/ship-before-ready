---
import Brand from './Brand.astro';
import Closing from './Closing.astro';
import Figure from './Figure.astro';
import Footer from './Footer.astro';
import Hero from './Hero.astro';
import Pains from './Pains.astro';
import PromiseScreen from './PromiseScreen.astro';
import Steps from './Steps.astro';

const BAND = 'border-t border-line py-block md:py-section';
---

<PromiseScreen>
  <header class="border-b border-line py-group">
    <Brand />
  </header>
  <div class="flex flex-col gap-block py-block md:flex-row md:items-start md:justify-between md:py-section">
    <Hero />
    <Figure class="w-full md:w-1/4 md:shrink-0" />
  </div>
  <div class={BAND}>
    <Pains />
  </div>
  <div class={BAND}>
    <Steps />
  </div>
  <div class={BAND}>
    <Closing />
  </div>
  <Footer />
</PromiseScreen>
