---
import { tokens } from '../lib/tokens';
import Brand from './Brand.astro';
import Closing from './Closing.astro';
import Figure from './Figure.astro';
import Footer from './Footer.astro';
import Hero from './Hero.astro';
import Pains from './Pains.astro';
import PromiseScreen from './PromiseScreen.astro';
import Steps from './Steps.astro';

const BAND = 'pb-block md:pb-section';
---

<PromiseScreen>
  <header class="pt-group text-center">
    <Brand />
  </header>
  <div class="py-block md:py-section">
    <Hero />
  </div>
  {
    tokens.decor !== 'none' && (
      <div class:list={['flex justify-center', BAND]}>
        <Figure class="w-full md:w-1/2" />
      </div>
    )
  }
  <div class={BAND}>
    <Pains />
  </div>
  <div class={BAND}>
    <Steps />
  </div>
  <div class={BAND}>
    <Closing />
  </div>
  <Footer />
</PromiseScreen>
