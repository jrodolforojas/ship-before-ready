---
import { copy } from '../lib/copy';
import { tokens } from '../lib/tokens';
import FilledButton from './FilledButton.astro';

const layout = {
  centered: {
    hero: 'flex flex-col items-center gap-group text-center',
    heading: 'flex flex-col items-center gap-item',
    subtitle: 'max-w-prose',
    button: 'w-full md:w-auto',
  },
  split: {
    hero: 'flex flex-col items-start gap-group',
    heading: 'flex flex-col gap-item',
    subtitle: 'max-w-prose',
    button: 'w-full md:w-auto',
  },
  editorial: {
    hero: 'flex max-w-prose flex-col items-start gap-group text-body',
    heading: 'flex flex-col gap-item',
    subtitle: '',
    button: 'w-auto',
  },
}[tokens.composition];
---

<div class={layout.hero}>
  <div class={layout.heading}>
    <h1 data-sbr="title" id="title" class="font-display text-title text-balance text-ink">{copy.hero.title}</h1>
    <p data-sbr="subtitle" class:list={['font-body text-lead text-pretty text-ink-muted', layout.subtitle]}>{copy.hero.subtitle}</p>
  </div>
  <FilledButton hook="cta" label={copy.cta} class={layout.button} />
</div>
